# Synapse public site (internal name: madness). Generated by install.sh from deploy/site.caddy.tmpl.
# Caddy gets the HTTPS certificate automatically.
__DOMAIN__ {
	request_body {
		max_size 4MB
	}
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}
	# one-time GPU pairing (only answers while `madness pair` is running)
	handle_path /_pair/* {
		reverse_proxy 127.0.0.1:51821
	}
	handle {
		reverse_proxy 127.0.0.1:18090 {
			flush_interval -1
			transport http {
				read_timeout 15m
			}
		}
	}
}
