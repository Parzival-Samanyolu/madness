# This file is created automatically by install.sh. You normally never edit it by hand.
# Use `sudo madness set KEY VALUE` to change a value safely.

# ---- both machines
ROLE=vps                      # vps | gpu
LLM_API_KEY=                  # shared secret between API and model server

# ---- VPS
PUBLIC_IP=
DOMAIN=synapse.203-0-113-7.sslip.io   # or your own: sudo madness domain example.com
COMPOSE_PROFILES=            # 'edge' when the VPS has no Caddy of its own
SECRET_KEY=
POSTGRES_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SIGNUPS_OPEN=true
APP_NAME=Madness

# ---- GPU box (written by pairing)
TUNNEL_HOST=
TUNNEL_USER=madness-tunnel
TUNNEL_PORT=18080
LLM_CTX=524288                # shared context pool (tokens) for all chats: 4 x 131072
LLM_PARALLEL=4                # chats generating at the same time
# LLM_MODEL=ggml-org/Inkling-2-Mini-GGUF:IQ4_NL
# Back to Qwen3.6 (also set MODEL_NAME=qwen3.6-35b-a3b on the VPS):
# LLM_MODEL=unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q4_K_M  LLM_CTX=262144  LLM_CPU_MOE=28
# LLM_TEMP=0.6  LLM_TOP_P=0.95  LLM_TOP_K=20
